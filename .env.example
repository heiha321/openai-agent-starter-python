# ========== LLM 网关（本地调试用） ==========
# 在 EdgeOne Makers 控制台 → 自定义智能体 → 模型与密钥 中获取
# 本地执行 `edgeone makers dev` 时会自动同步到 .env，一般无需手填
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 可选：模型名，默认 @makers/deepseek-v4-flash
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德开放平台 Web 服务 Key（必填） ==========
# 申请：https://console.amap.com → 应用管理 → 创建应用 → 添加 Key
# 服务平台必须选「Web 服务」，选错会返回 INVALID_USER_KEY / 鉴权失败
AMAP_API_KEY=your-amap-web-service-key
